{
  "lexicon": 1,
  "id": "com.selfcommand.admin.inbox.getUnreadCount",
  "description": "Read a user's Ozone moderation unread counts. Requires moderation.read. Read-only. Requires a service JWT obtained from the caller PDS (com.atproto.server.getServiceAuth) with aud set to the admin service DID and lxm set to the invoked method.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": [
          "did"
        ],
        "properties": {
          "did": {
            "type": "string",
            "format": "did"
          },
          "section": {
            "type": "string",
            "knownValues": [
              "reports",
              "subjects",
              "accountStatus"
            ]
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "unreadCounts"
          ],
          "properties": {
            "unreadCounts": {
              "type": "ref",
              "ref": "com.selfcommand.admin.inbox.defs#unreadCounts"
            }
          }
        }
      },
      "errors": [
        {
          "name": "Forbidden",
          "description": "The caller lacks the permission for this method."
        },
        {
          "name": "NotConfigured",
          "description": "The Ozone client credential is not configured."
        },
        {
          "name": "UpstreamAuthFailed",
          "description": "Ozone rejected the administrator credential."
        },
        {
          "name": "UpstreamUnavailable",
          "description": "Ozone is unreachable or timed out."
        },
        {
          "name": "RateLimited",
          "description": "Ozone rate limited the request."
        }
      ]
    }
  }
}
