{
  "lexicon": 1,
  "id": "com.selfcommand.admin.security.blocked.list",
  "description": "List accounts blocked from the admin console, newest block first. Requires a service JWT (com.atproto.server.getServiceAuth) and security.read. Blocks only affect admin console access; they never affect PDS sign-in or community usage.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "properties": {
          "cursor": {
            "type": "string",
            "maxLength": 2048
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 50
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["blocks", "total"],
          "properties": {
            "cursor": {
              "type": "string"
            },
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "blocks": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "com.selfcommand.admin.defs#accessBlock"
              }
            }
          }
        }
      },
      "errors": [
        {
          "name": "Forbidden",
          "description": "The caller lacks security.read."
        }
      ]
    }
  }
}