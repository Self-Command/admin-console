{
  "lexicon": 1,
  "id": "com.selfcommand.admin.signature.findRelatedAccounts",
  "description": "Find Ozone accounts that share threat signatures with the root account. Requires moderation.read. Requires a service JWT obtained from the caller PDS (com.atproto.server.getServiceAuth) with aud set to the admin service DID and lxm set to the invoked method.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": [
          "did"
        ],
        "properties": {
          "did": {
            "type": "string",
            "format": "did"
          },
          "cursor": {
            "type": "string",
            "maxLength": 2048
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "accounts"
          ],
          "properties": {
            "accounts": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "com.selfcommand.admin.signature.defs#relatedAccount"
              }
            },
            "cursor": {
              "type": "string"
            }
          }
        }
      },
      "errors": [
        {
          "name": "Forbidden",
          "description": "The caller lacks the permission for this method."
        },
        {
          "name": "NotConfigured",
          "description": "The Ozone client credential is not configured."
        },
        {
          "name": "NotFound",
          "description": "The account is not known to Ozone."
        },
        {
          "name": "UpstreamAuthFailed",
          "description": "Ozone rejected the administrator credential."
        },
        {
          "name": "UpstreamUnavailable",
          "description": "Ozone is unreachable or timed out."
        },
        {
          "name": "RateLimited",
          "description": "Ozone rate limited the request."
        }
      ]
    }
  }
}
