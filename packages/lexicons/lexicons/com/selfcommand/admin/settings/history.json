{
  "lexicon": 1,
  "id": "com.selfcommand.admin.settings.history",
  "description": "List revisions of one runtime setting partition, newest first. Requires a service JWT (com.atproto.server.getServiceAuth) and settings.read.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": ["section"],
        "properties": {
          "section": {
            "type": "string",
            "knownValues": [
              "branding",
              "theme",
              "login",
              "navigation",
              "features",
              "ui",
              "integrations",
              "audit",
              "indexer"
            ]
          },
          "cursor": {
            "type": "string",
            "maxLength": 2048
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["revisions", "total"],
          "properties": {
            "cursor": {
              "type": "string"
            },
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "revisions": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "com.selfcommand.admin.defs#settingRevision"
              }
            }
          }
        }
      },
      "errors": [
        {
          "name": "Forbidden",
          "description": "The caller lacks settings.read."
        },
        {
          "name": "InvalidRequest",
          "description": "The section or cursor is not valid."
        }
      ]
    }
  }
}
