{
  "lexicon": 1,
  "id": "com.selfcommand.admin.settings.export",
  "description": "Export every runtime setting partition and its version metadata as a portable document. Requires a service JWT (com.atproto.server.getServiceAuth) and settings.read. Uploaded logo bytes and secrets are never included.",
  "defs": {
    "main": {
      "type": "query",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["exportedAt", "sections", "meta"],
          "properties": {
            "exportedAt": {
              "type": "string",
              "format": "datetime"
            },
            "sections": {
              "type": "ref",
              "ref": "com.selfcommand.admin.defs#settingsSections"
            },
            "meta": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "com.selfcommand.admin.defs#settingMeta"
              }
            }
          }
        }
      },
      "errors": [
        {
          "name": "Forbidden",
          "description": "The caller lacks settings.read."
        }
      ]
    }
  }
}
