{
  "lexicon": 1,
  "id": "com.selfcommand.admin.moderation.scheduled.list",
  "description": "List scheduled moderation actions. Requires a service JWT obtained from the caller PDS (com.atproto.server.getServiceAuth) with aud set to the admin service DID and lxm set to the invoked method.",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [],
          "properties": {
            "statuses": {
              "type": "array",
              "items": {
                "type": "string",
                "knownValues": [
                  "pending",
                  "executed",
                  "cancelled",
                  "failed"
                ]
              },
              "maxLength": 4
            },
            "subjects": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "did"
              },
              "maxLength": 100
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "cursor": {
              "type": "string",
              "maxLength": 2048
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "actions"
          ],
          "properties": {
            "actions": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "com.selfcommand.admin.defs#scheduledActionView"
              }
            },
            "cursor": {
              "type": "string"
            }
          }
        }
      },
      "errors": [
        {
          "name": "Forbidden",
          "description": "The caller lacks the permission for this method."
        },
        {
          "name": "NotConfigured",
          "description": "The upstream service credential is not configured."
        },
        {
          "name": "UpstreamAuthFailed",
          "description": "The upstream service rejected the administrator credential."
        },
        {
          "name": "UpstreamUnavailable",
          "description": "The upstream service is unreachable or timed out."
        },
        {
          "name": "RateLimited",
          "description": "The upstream service rate limited the request."
        }
      ]
    }
  }
}
