{
  "lexicon": 1,
  "id": "com.selfcommand.admin.content.export",
  "description": "Export posts matching the content search filters as UTF-8 CSV generated by the admin service. Requires a service JWT obtained from the caller PDS (com.atproto.server.getServiceAuth) with aud set to the admin service DID and lxm set to the invoked method. The export stops at the configured row limit and flags truncation instead of silently dropping rows; every export is audited and rate limited.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "properties": {
          "q": {
            "type": "string",
            "maxLength": 256
          },
          "author": {
            "type": "string",
            "maxLength": 256,
            "description": "Handle or DID of the author."
          },
          "mention": {
            "type": "string",
            "maxLength": 256
          },
          "lang": {
            "type": "string",
            "maxLength": 16
          },
          "domain": {
            "type": "string",
            "maxLength": 253
          },
          "url": {
            "type": "string",
            "maxLength": 2048
          },
          "tag": {
            "type": "string",
            "maxLength": 64
          },
          "since": {
            "type": "string",
            "format": "datetime"
          },
          "until": {
            "type": "string",
            "format": "datetime"
          },
          "sort": {
            "type": "string",
            "knownValues": [
              "latest",
              "top"
            ],
            "default": "latest"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "filename",
            "contentType",
            "content",
            "rows",
            "truncated",
            "limit"
          ],
          "properties": {
            "filename": {
              "type": "string"
            },
            "contentType": {
              "type": "string"
            },
            "content": {
              "type": "string"
            },
            "rows": {
              "type": "integer",
              "minimum": 0
            },
            "truncated": {
              "description": "True when more rows matched than the row limit; the export stops at the limit.",
              "type": "boolean"
            },
            "limit": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "errors": [
        {
          "name": "Forbidden",
          "description": "The caller lacks content.read."
        },
        {
          "name": "NotConfigured",
          "description": "The app view credential or URL is not configured."
        },
        {
          "name": "UpstreamAuthFailed",
          "description": "The upstream service rejected the administrator credential."
        },
        {
          "name": "UpstreamUnavailable",
          "description": "The app view is unreachable or timed out; no file is generated."
        },
        {
          "name": "RateLimited",
          "description": "The export or the upstream service was rate limited."
        }
      ]
    }
  }
}
