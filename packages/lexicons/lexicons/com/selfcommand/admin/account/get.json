{
  "lexicon": 1,
  "id": "com.selfcommand.admin.account.get",
  "description": "Read a single account from the locally indexed directory. Requires a service JWT (com.atproto.server.getServiceAuth) and any workspace role.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": ["did"],
        "properties": {
          "did": {
            "type": "string",
            "format": "did"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["account", "indexer"],
          "properties": {
            "account": {
              "type": "ref",
              "ref": "com.selfcommand.admin.defs#account"
            },
            "indexer": {
              "type": "ref",
              "ref": "com.selfcommand.admin.defs#indexerStatus"
            }
          }
        }
      },
      "errors": [
        {
          "name": "Forbidden",
          "description": "The caller has no role in the workspace."
        },
        {
          "name": "AccountNotFound",
          "description": "The DID is not present in the indexed directory."
        }
      ]
    }
  }
}
