{
  "lexicon": 1,
  "id": "com.selfcommand.admin.announcement.create",
  "description": "Create an announcement draft. The body is stored and rendered as plain text; HTML is rejected. Requires a service JWT obtained from the caller PDS (com.atproto.server.getServiceAuth) with aud set to the admin service DID and lxm set to the invoked method.",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "title",
            "body",
            "level",
            "placement"
          ],
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 120
            },
            "body": {
              "type": "string",
              "maxLength": 5000
            },
            "level": {
              "type": "ref",
              "ref": "com.selfcommand.admin.defs#announcementLevel"
            },
            "placement": {
              "type": "ref",
              "ref": "com.selfcommand.admin.defs#announcementPlacement"
            },
            "startsAt": {
              "type": "string",
              "format": "datetime"
            },
            "endsAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "announcement"
          ],
          "properties": {
            "announcement": {
              "type": "ref",
              "ref": "com.selfcommand.admin.defs#announcementView"
            }
          }
        }
      },
      "errors": [
        {
          "name": "Forbidden",
          "description": "The caller lacks announcement.write."
        },
        {
          "name": "InvalidRequest",
          "description": "A field is empty, too long, contains HTML, or the time window is invalid."
        }
      ]
    }
  }
}
