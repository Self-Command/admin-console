{
  "lexicon": 1,
  "id": "com.selfcommand.admin.audit.list",
  "description": "List audit events newest first. Requires a service JWT (com.atproto.server.getServiceAuth) and the admin role.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "properties": {
          "cursor": {
            "type": "string",
            "maxLength": 2048
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "actor": {
            "type": "string",
            "format": "did"
          },
          "action": {
            "type": "string",
            "maxLength": 128
          },
          "result": {
            "type": "string",
            "knownValues": ["success", "denied", "error"]
          },
          "since": {
            "type": "string",
            "format": "datetime"
          },
          "until": {
            "type": "string",
            "format": "datetime"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["events", "total"],
          "properties": {
            "cursor": {
              "type": "string"
            },
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "events": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "com.selfcommand.admin.defs#auditEvent"
              }
            }
          }
        }
      },
      "errors": [
        {
          "name": "Forbidden",
          "description": "The caller has no role or the role is not allowed to read audit events."
        }
      ]
    }
  }
}
