{
  "lexicon": 1,
  "id": "com.selfcommand.admin.policy.safelink.list",
  "description": "List external link safety rules. Requires a service JWT obtained from the caller PDS (com.atproto.server.getServiceAuth) with aud set to the admin service DID and lxm set to the invoked method.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "properties": {
          "urls": {
            "type": "array",
            "maxLength": 100,
            "items": {
              "type": "string",
              "maxLength": 2048
            }
          },
          "patternType": {
            "type": "string",
            "knownValues": [
              "domain",
              "url"
            ]
          },
          "actions": {
            "type": "array",
            "maxLength": 3,
            "items": {
              "type": "string",
              "knownValues": [
                "block",
                "warn",
                "whitelist"
              ]
            }
          },
          "reason": {
            "type": "string",
            "knownValues": [
              "csam",
              "spam",
              "phishing",
              "none"
            ]
          },
          "source": {
            "type": "string",
            "maxLength": 128
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "cursor": {
            "type": "string",
            "maxLength": 2048
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "rules"
          ],
          "properties": {
            "rules": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "com.selfcommand.admin.defs#safelinkRuleView"
              }
            },
            "cursor": {
              "type": "string"
            }
          }
        }
      },
      "errors": [
        {
          "name": "Forbidden",
          "description": "The caller lacks the permission for this method."
        },
        {
          "name": "NotConfigured",
          "description": "The upstream service credential is not configured."
        },
        {
          "name": "UpstreamAuthFailed",
          "description": "The upstream service rejected the administrator credential."
        },
        {
          "name": "UpstreamUnavailable",
          "description": "The upstream service is unreachable, timed out or returned an unexpected payload."
        },
        {
          "name": "RateLimited",
          "description": "The upstream service rate limited the request."
        }
      ]
    }
  }
}
