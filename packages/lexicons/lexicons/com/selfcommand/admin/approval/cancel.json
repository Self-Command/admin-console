{
  "lexicon": 1,
  "id": "com.selfcommand.admin.approval.cancel",
  "description": "Withdraw a pending approval request. Requires a service JWT (com.atproto.server.getServiceAuth). Only the requester can withdraw the request.",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 64
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["approval"],
          "properties": {
            "approval": {
              "type": "ref",
              "ref": "com.selfcommand.admin.defs#approval"
            }
          }
        }
      },
      "errors": [
        {
          "name": "Forbidden",
          "description": "The caller is not the requester."
        },
        {
          "name": "ApprovalState",
          "description": "The request is expired or already decided."
        }
      ]
    }
  }
}