{
  "lexicon": 1,
  "id": "com.selfcommand.admin.approval.list",
  "description": "List approval requests for high-risk actions. Requires a service JWT (com.atproto.server.getServiceAuth) and security.read.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "properties": {
          "status": {
            "type": "string",
            "knownValues": [
              "pending",
              "executed",
              "rejected",
              "cancelled",
              "expired",
              "failed"
            ]
          },
          "cursor": {
            "type": "string",
            "maxLength": 2048
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 50
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["approvals", "total"],
          "properties": {
            "cursor": {
              "type": "string"
            },
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "approvals": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "com.selfcommand.admin.defs#approval"
              }
            }
          }
        }
      },
      "errors": [
        {
          "name": "Forbidden",
          "description": "The caller lacks security.read."
        }
      ]
    }
  }
}