{
  "lexicon": 1,
  "id": "com.selfcommand.admin.indexer.resume",
  "description": "Resume the account directory indexer from the persisted cursor. Requires a service JWT (com.atproto.server.getServiceAuth) and settings.write. The resume is audited.",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": {
              "type": "ref",
              "ref": "com.selfcommand.admin.defs#indexerStatus"
            }
          }
        }
      },
      "errors": [
        {
          "name": "Forbidden",
          "description": "The caller lacks settings.write."
        }
      ]
    }
  }
}
